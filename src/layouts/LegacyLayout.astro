---
interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  /** Matches original CSS bundle order */
  headVariant: "home" | "article" | "bloglist";
  ogImage?: string;
}

const {
  title,
  description = "",
  canonicalPath = "/",
  headVariant,
  ogImage = "https://resume.jocal.dev/images/embed.jpg"
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="keywords" content="" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <link
      href="https://fonts.googleapis.com/css?family=Poppins:300,300i,400,400i,500,500i,600,600i,700,700i|Playfair+Display:400,400i,700,700i,900,900i"
      rel="stylesheet"
    />
    <link href="/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/ionicons/css/ionicons.min.css" rel="stylesheet" />
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />
    <link href="/lib/magnific-popup/magnific-popup.css" rel="stylesheet" />
    <link href="/lib/hover/hover.min.css" rel="stylesheet" />

    {
      headVariant === "home" && (
        <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
      )
    }

    {
      headVariant === "article" && (
        <>
          <link href="/css/blog.css" rel="stylesheet" />
          <link href="/css/style.css" rel="stylesheet" />
          <link href="/css/responsive.css" rel="stylesheet" />
        </>
      )
    }

    {
      headVariant === "bloglist" && (
        <>
          <link href="/css/style.css" rel="stylesheet" />
          <link href="/css/blog.css" rel="stylesheet" />
          <link href="/css/responsive.css" rel="stylesheet" />
        </>
      )
    }

    {
      headVariant === "home" && (
        <>
          <link href="/css/style.css" rel="stylesheet" />
          <link href="/css/responsive.css" rel="stylesheet" />
          <link rel="stylesheet" href="/css/styles.css" />
        </>
      )
    }

    <link rel="shortcut icon" href="/images/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="" />
    <meta property="og:description" content={description} />
    <meta name="twitter:title" content="" />
    <meta name="twitter:image" content="" />
    <meta name="twitter:url" content="" />
    <meta name="twitter:card" content={ogImage} />
  </head>
  <body>
    <slot />

    <!-- JavaScript Libraries -->
    <script is:inline src="/lib/jquery/jquery.min.js"></script>
    <script is:inline src="/lib/jquery/jquery-migrate.min.js"></script>
    <script is:inline src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script is:inline src="/lib/typed/typed.js"></script>
    <script is:inline src="/lib/owlcarousel/owl.carousel.min.js"></script>
    <script is:inline src="/lib/magnific-popup/magnific-popup.min.js"></script>
    <script is:inline src="/lib/isotope/isotope.pkgd.min.js"></script>
    <script is:inline src="/contactform/contactform.js"></script>
    <script is:inline src="/js/main.js"></script>
    {
      headVariant === "home" && (
        <>
          <script
            is:inline
            src="https://cdn.jsdelivr.net/npm/typed.js@2.0.12"
          />
          <script
            is:inline
            src="https://unpkg.com/swiper/swiper-bundle.min.js"
          />
        </>
      )
    }
  </body>
</html>
